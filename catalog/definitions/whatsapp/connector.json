  "description": "Provides official Domainry WhatsApp Business Connector definitions, Provider choices, and operation contracts.",
  "i18n": {
    "en-US": {
      "description": "Provides official Domainry WhatsApp Business Connector definitions, Provider choices, and operation contracts.",
      "name": "WhatsApp Business"
    },
    "zh-CN": {
      "description": "提供 Domainry 官方WhatsApp Business连接器定义、Provider 选项与操作契约。",
      "name": "WhatsApp Business"
    }
  },
  "key": "whatsapp",
  "name": "WhatsApp Business",
  "operations": [
    {
      "description": "Execute the test connection operation.",
      "execution_mode": "sync",
      "i18n": {
        "en-US": {
          "description": "Execute the test connection operation.",
          "name": "test connection"
        },
        "zh-CN": {
          "description": "执行“测试连接”操作。",
          "name": "测试连接"
        }
      },
      "key": "test_connection",
      "method": "GET",
      "name": "test connection",
      "side_effect": "read",
      "timeout_default_seconds": 15,
      "timeout_max_seconds": 30
    },
    {
      "description": "List WhatsApp message templates and their Meta review status.",
      "execution_mode": "sync",
      "i18n": {
        "en-US": {
          "description": "List approved and pending WhatsApp message templates from Meta.",
          "name": "list message templates"
        },
        "zh-CN": {
          "description": "从 Meta 获取已审核或审核中的 WhatsApp 消息模板。",
          "name": "获取消息模板"
        }
      },
      "input": [
        {
          "key": "status",
          "name": "Review Status",
          "type": "text"
        }
      ],
      "key": "list_templates",
      "method": "GET",
      "name": "list message templates",
      "side_effect": "read",
      "timeout_default_seconds": 15,
      "timeout_max_seconds": 30
    },
    {
      "description": "Execute the send message operation.",
      "execution_mode": "sync",
      "i18n": {
        "en-US": {
          "description": "Execute the send message operation.",
          "name": "send message"
        },
        "zh-CN": {
          "description": "执行“发送消息”操作。",
          "name": "发送消息"
        }
      },
      "idempotency_supported": true,
      "input": [
        {
          "key": "recipient",
          "name": "Recipient Phone",
          "required": true,
          "type": "text"
        },
        {
          "key": "message",
          "name": "Message",
          "required": true,
          "type": "long_text"
        },
        {
          "key": "provider_payload",
          "name": "Provider Payload",
          "description": "Deprecated immutable native payload retained only for previously persisted outbox messages.",
          "type": "json"
        },
        {
          "key": "notification_content",
          "name": "Notification Content",
          "description": "Versioned provider-neutral rendered notification snapshot compiled by the selected provider.",
          "type": "json"
        }
      ],
      "key": "send_message",
      "method": "POST",
      "name": "send message",
      "side_effect": "write",
      "timeout_default_seconds": 15,
      "timeout_max_seconds": 30
    }
  ],
