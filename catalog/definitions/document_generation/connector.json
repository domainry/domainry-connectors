      "key": "test_connection",
      "name": "Test PDF Provider",
      "description": "Verify that the Runtime PDF renderer is available.",
      "i18n": {"en-US": {"name": "Test PDF Provider", "description": "Verify that the Runtime PDF renderer is available."}, "zh-CN": {"name": "测试 PDF Provider", "description": "验证 Runtime PDF 渲染器可用。"}},
      "method": "GET", "execution_mode": "sync", "side_effect": "read", "test_supported": true,
      "timeout_default_seconds": 5, "timeout_max_seconds": 15,
      "output": [{"key": "connected", "name": "Connected", "type": "boolean", "required": true}]
    },
    {
      "key": "render_pdf",
      "name": "Render PDF",
      "description": "Render a PDF document inside the user's Runtime instance.",
      "i18n": {"en-US": {"name": "Render PDF", "description": "Render a PDF document inside the user's Runtime instance."}, "zh-CN": {"name": "渲染 PDF", "description": "在用户自己的 Runtime 实例内渲染 PDF 文档。"}},
      "method": "POST", "execution_mode": "sync", "side_effect": "write", "idempotency_supported": true,
      "timeout_default_seconds": 10, "timeout_max_seconds": 30,
      "input": [
        {"key": "title", "name": "Title", "type": "text", "required": true},
        {"key": "content", "name": "Content", "type": "long_text", "required": true},
        {"key": "filename", "name": "Filename", "type": "text", "required": false}
      ],
      "output": [
        {"key": "filename", "name": "Filename", "type": "text", "required": true},
        {"key": "mime_type", "name": "MIME Type", "type": "text", "required": true},
        {"key": "document_base64", "name": "Document Base64", "type": "long_text", "required": true},
        {"key": "sha256", "name": "SHA-256", "type": "text", "required": true},
        {"key": "bytes", "name": "Bytes", "type": "integer", "required": true},
        {"key": "signature_hmac_sha256", "name": "HMAC Signature", "type": "text", "required": false}
      ]
    }
